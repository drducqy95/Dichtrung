{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strict Translation Result V2",
  "type": "object",
  "required": [
    "schema_version",
    "chapter_id",
    "source_manifest_hash",
    "chapter_title_translated",
    "segment_translations",
    "new_terms_discovered",
    "new_characters_discovered",
    "chapter_summary",
    "worldbuilding_updates",
    "timeline_entry",
    "analysis_candidates"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "chapter_id": { "type": "string", "pattern": "^chapter_[0-9]{4}$" },
    "source_manifest_hash": { "$ref": "#/definitions/hash" },
    "chapter_title_translated": { "type": "string" },
    "segment_translations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/segmentTranslation" }
    },
    "new_terms_discovered": {
      "type": "array",
      "items": { "$ref": "#/definitions/discoveredTerm" }
    },
    "new_characters_discovered": {
      "type": "array",
      "items": { "$ref": "#/definitions/discoveredCharacter" }
    },
    "chapter_summary": { "type": "string" },
    "worldbuilding_updates": { "$ref": "#/definitions/worldbuildingUpdates" },
    "timeline_entry": { "$ref": "#/definitions/timelineEntry" },
    "analysis_candidates": { "$ref": "#/definitions/analysisCandidates" },
    "refusal": { "type": "string" }
  },
  "additionalProperties": false,
  "definitions": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "segmentId": { "type": "string", "pattern": "^chapter_[0-9]{4}:seg_[0-9]{4}$" },
    "segmentTranslation": {
      "type": "object",
      "required": ["segment_ids", "target", "narrative_type"],
      "properties": {
        "segment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/segmentId" }
        },
        "target": { "type": "string", "minLength": 1 },
        "narrative_type": {
          "enum": ["narration", "dialogue", "inner_thought", "description"]
        }
      },
      "additionalProperties": false
    },
    "discoveredTerm": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "discoveredCharacter": {
      "type": "object",
      "required": ["name_original", "name_translated"],
      "properties": {
        "id": { "type": "string" },
        "name_original": { "type": "string" },
        "name_translated": { "type": "string" },
        "name_source": { "type": "string" },
        "name_target": { "type": "string" },
        "gender": { "type": "string" },
        "age_group": { "type": "string" },
        "description": { "type": "string" },
        "pronouns": { "type": "object" },
        "role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "worldbuildingItem": {
      "type": "object",
      "properties": {
        "name_source": { "type": "string" },
        "name_target": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "worldbuildingUpdates": {
      "type": "object",
      "required": ["factions", "locations", "techniques", "items", "cultivation_resources"],
      "properties": {
        "factions": { "type": "array", "items": { "$ref": "#/definitions/worldbuildingItem" } },
        "locations": { "type": "array", "items": { "$ref": "#/definitions/worldbuildingItem" } },
        "techniques": { "type": "array", "items": { "$ref": "#/definitions/worldbuildingItem" } },
        "items": { "type": "array", "items": { "$ref": "#/definitions/worldbuildingItem" } },
        "cultivation_resources": { "type": "array", "items": { "$ref": "#/definitions/worldbuildingItem" } }
      },
      "additionalProperties": false
    },
    "timelineCharacter": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "interaction": { "type": "string" },
        "is_new": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "timelineEntry": {
      "type": "object",
      "required": ["chapter", "title", "summary", "characters", "plot_points"],
      "properties": {
        "chapter": { "type": "integer" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "characters": { "type": "array", "items": { "$ref": "#/definitions/timelineCharacter" } },
        "items": { "type": "array" },
        "plot_points": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string" }
      },
      "additionalProperties": false
    },
    "termCandidate": {
      "type": "object",
      "required": ["source_term", "target_term", "segment_id"],
      "properties": {
        "source_term": { "type": "string" },
        "target_term": { "type": "string" },
        "segment_id": { "$ref": "#/definitions/segmentId" },
        "category": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "entityCandidate": {
      "type": "object",
      "required": ["source_surface", "target_surface", "entity_type", "segment_id"],
      "properties": {
        "source_surface": { "type": "string" },
        "target_surface": { "type": "string" },
        "entity_type": { "type": "string" },
        "segment_id": { "$ref": "#/definitions/segmentId" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "nameCandidate": {
      "type": "object",
      "required": ["name_source", "name_target", "segment_id"],
      "properties": {
        "name_source": { "type": "string" },
        "name_target": { "type": "string" },
        "segment_id": { "$ref": "#/definitions/segmentId" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "patternCandidate": {
      "type": "object",
      "required": ["alias", "source_pattern", "target_pattern", "segment_ids", "confidence"],
      "properties": {
        "alias": { "type": "string" },
        "source_pattern": { "type": "string" },
        "target_pattern": { "type": "string" },
        "segment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/segmentId" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "candidateReportBase": {
      "type": "object",
      "required": ["status", "evidence_count", "items"],
      "properties": {
        "status": { "enum": ["ok", "no_evidence"] },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "items": { "type": "array" }
      },
      "additionalProperties": false
    },
    "termCandidateReport": {
      "allOf": [
        { "$ref": "#/definitions/candidateReportBase" },
        {
          "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/termCandidate" } } }
        },
        { "$ref": "#/definitions/statusInvariant" }
      ]
    },
    "entityCandidateReport": {
      "allOf": [
        { "$ref": "#/definitions/candidateReportBase" },
        {
          "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/entityCandidate" } } }
        },
        { "$ref": "#/definitions/statusInvariant" }
      ]
    },
    "nameCandidateReport": {
      "allOf": [
        { "$ref": "#/definitions/candidateReportBase" },
        {
          "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/nameCandidate" } } }
        },
        { "$ref": "#/definitions/statusInvariant" }
      ]
    },
    "patternCandidateReport": {
      "allOf": [
        { "$ref": "#/definitions/candidateReportBase" },
        {
          "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/patternCandidate" } } }
        },
        { "$ref": "#/definitions/statusInvariant" }
      ]
    },
    "statusInvariant": {
      "if": { "properties": { "status": { "const": "no_evidence" } } },
      "then": {
        "properties": {
          "evidence_count": { "const": 0 },
          "items": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "evidence_count": { "minimum": 1 },
          "items": { "minItems": 1 }
        }
      }
    },
    "analysisCandidates": {
      "type": "object",
      "required": [
        "term_occurrences",
        "entity_mentions",
        "name_mentions",
        "phrase_patterns",
        "grammar_rule_candidates"
      ],
      "properties": {
        "term_occurrences": { "$ref": "#/definitions/termCandidateReport" },
        "entity_mentions": { "$ref": "#/definitions/entityCandidateReport" },
        "name_mentions": { "$ref": "#/definitions/nameCandidateReport" },
        "phrase_patterns": { "$ref": "#/definitions/patternCandidateReport" },
        "grammar_rule_candidates": { "$ref": "#/definitions/patternCandidateReport" }
      },
      "additionalProperties": false
    }
  }
}
